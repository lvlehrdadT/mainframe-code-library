```jcl
//SPTEST   JOB CLASS=A,MSGCLASS=A,NOTIFY=&SYSUID,REGION=0M
//*---------------------------------------------------------------
//* CREATE A REXX STORED PROCEDURE IN DB2 FOR z/OS
//* NOTE: REPLACE PLACEHOLDER DATA SETS AND DB2 SSID
//*       WITH VALUES APPROVED FOR YOUR ENVIRONMENT.
//*---------------------------------------------------------------
//JOBLIB   DD  DSN=YOUR.CEE.SCEERUN,DISP=SHR
//         DD  DSN=YOUR.DB2.SDSNEXIT,DISP=SHR
//         DD  DSN=YOUR.DB2.SDSNLOAD,DISP=SHR
//         DD  DSN=YOUR.REXX.RUNLIB.LOAD,DISP=SHR
//*
//STEP1    EXEC PGM=IKJEFT01,DYNAMNBR=20
//SYSTSPRT DD  SYSOUT=*
//SYSTSIN  DD  *
  DSN SYSTEM(DB2SSID)
  RUN PROGRAM(DSNTIAD) PLAN(DSNTIA10) -
      PARM('SQLTERM(%)')
  END
//SYSPRINT DD  SYSOUT=*
//SYSIN    DD  *
CREATE PROCEDURE SAMPLE_SCHEMA.SAMPLE_REXX_PROC
(
    IN  P_INPUT  VARCHAR(30),
    OUT P_OUTPUT VARCHAR(200)
)
    DYNAMIC RESULT SETS 0
    EXTERNAL NAME SAMPLE_REXX_PROC
    LANGUAGE REXX
    PARAMETER STYLE GENERAL
    NOT DETERMINISTIC
    NO DBINFO                
    WLM ENVIRONMENT REXXWLM  
    COLLID           --your collid
    
%
/*
